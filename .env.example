# CanHook MCP — environment template. Copy to .env and fill in real values.
# .env is git-excluded. Node NEVER sees OAUTH_ENC_KEY (that lives only on the PHP side).

CANHOOK_BASE_URL=https://canhook.com
OAUTH_ISSUER=https://canhook.com

# Local bind (reverse-proxied by OLS as https://canhook.com/mcp)
MCP_HOST=127.0.0.1
MCP_PORT=8790

# Read-only MariaDB pool (SELECT-only grant). For production point at `canhook`.
DB_HOST=127.0.0.1
DB_NAME=canhook
DB_USER=canhook_mcp_ro
DB_PASS=CHANGE_ME

# Must match the CanHook PHP config values.
INTROSPECTION_SECRET=CHANGE_ME
INTERNAL_API_SECRET=CHANGE_ME

# Tuning
INTROSPECT_CACHE_TTL_MS=60000
RATE_LIMIT_PER_MIN=120

# Loopback base for the PHP /internal/* write API (PHP 404s non-loopback callers)
INTERNAL_API_BASE_URL=http://127.0.0.1
